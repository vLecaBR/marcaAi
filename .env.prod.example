# ==============================================================================
# MarcaAí — variáveis de PRODUÇÃO (modelo). Copie para `.env.prod` (ignorado pelo git) e preencha.
#   cp .env.prod.example .env.prod
# NUNCA comite o .env.prod. Gerar segredos: veja docs/security-secrets.md.
# ==============================================================================

# ---- URLs públicas (https, domínio na Cloudflare) ----
APP_PUBLIC_URL=https://app.SEUDOMINIO.com.br
API_PUBLIC_URL=https://api.SEUDOMINIO.com.br
# E-mail do encarregado (DPO) exibido no rodapé/política. É embutido no build do front.
DPO_EMAIL=

# ---- Banco ----
POSTGRES_USER=marcaai
POSTGRES_DB=marcaai
POSTGRES_PASSWORD=TROQUE-por-uma-senha-forte

# ---- Segredos da API ----
# openssl rand -base64 64   (a API não sobe com chave curta nem com "dev"/"secret"/"changeme" no valor)
JWT_SIGNING_KEY=

# ---- E-mail transacional (Resend) — obrigatório em produção ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=MarcaAí <nao-responda@SEUDOMINIO.com.br>

# ---- Login Google (opcional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe (opcional até ativar cobrança; se SecretKey existir, os dois webhooks são obrigatórios) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_PRO=
STRIPE_PRICE_CLINICA=
STRIPE_PRICE_CLINICA_PRO=
STRIPE_PUBLISHABLE_KEY=

# ---- Mercado Pago / PIX (opcional; se ClientId existir, os demais são obrigatórios) ----
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
MP_ACCESS_TOKEN=

# ---- WhatsApp / Evolution (opcional) ----
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ---- Operação ----
# IDs (GUID) de usuários que podem abrir api.../hangfire (vazio = ninguém).
ADMIN_HANGFIRE_USER_IDS=
PRIVACY_POLICY_VERSION=1.0
# Minutos que a reserva de consulta paga online segura o horário esperando o pagamento
PAYMENT_HOLD_MINUTES=15

# ---- Cloudflare Tunnel (Zero Trust → Networks → Tunnels → token) ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Backup diário ----
# Chave PÚBLICA gerada com `age-keygen` (a privada fica no cofre de senhas, FORA do PC).
BACKUP_AGE_RECIPIENT=
BACKUP_CRON=30 3 * * *
TZ=America/Sao_Paulo
# Destino externo, ex.: Cloudflare R2:  BACKUP_RCLONE_REMOTE=r2:marcaai-backups
BACKUP_RCLONE_REMOTE=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ---- Portas locais (apenas 127.0.0.1) ----
WEB_PORT=3000
API_PORT=8080
