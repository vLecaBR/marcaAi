      SELECT b.uid, b."guestName", b."guestEmail", b."startTime"::timestamptz, b."endTime"::timestamptz, b.status, e.title, COALESCE(u.name, 'Profissional'), b."meetingUrl", b."guestTimeZone", b."userId", u.username, b."eventTypeId", e.slug, e."locationType"::text, e."locationValue", COALESCE(b."priceCents", e.price), e."payOnSite", b."paymentStatus"::text, b."paymentDueAt" IS NULL, b."paymentDueAt", b."rescheduleCount", e."bookingLimitDays"&#xD;
      FROM bookings AS b&#xD;
