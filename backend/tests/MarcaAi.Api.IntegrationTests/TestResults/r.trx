      SELECT b0.id, b0."cancelReason", b0."canceledAt", b0."canceledBy", b0."consentAt", b0."consentVersion", b0."createdAt", b0.currency, b0."endTime", b0."eventTypeId", b0."gatewayFeeCents", b0."guestEmail", b0."guestName", b0."guestNotes", b0."guestPhone", b0."guestTimeZone", b0."meetingId", b0."meetingUrl", b0."netToProviderCents", b0."paidAt", b0."paymentDueAt", b0."paymentProvider", b0."paymentReference", b0."paymentStatus", b0."payoutAccountId", b0."platformFeeCents", b0."priceCents", b0."providerPaymentId", b0."recurringEventId", b0."recurringIndex", b0."refundedAt", b0."reminderSent", b0."rescheduleCount", b0."startTime", b0.status, b0.uid, b0."updatedAt", b0."userId", e.id, e."afterEventBuffer", e."beforeEventBuffer", e."bookingLimitDays", e.color, e."createdAt", e.currency, e.description, e.duration, e."isActive", e."locationType", e."locationValue", e."payOnSite", e.price, e."requiresConfirm", e.slug, e."teamId", e.title, e."updatedAt", e."userId", u.id, u.bio, u."brandColor", u."clinicName", u.council, u."createdAt", u.email, u."emailVerified", u.image, u.locale, u.name, u.onboarded, u."recurringEventId", u."recurringIndex", u."registrationNumber", u.specialty, u.theme, u."timeZone", u."trialEndsAt", u."updatedAt", u.username&#xD;
      FROM (&#xD;
          SELECT b.id, b."cancelReason", b."canceledAt", b."canceledBy", b."consentAt", b."consentVersion", b."createdAt", b.currency, b."endTime", b."eventTypeId", b."gatewayFeeCents", b."guestEmail", b."guestName", b."guestNotes", b."guestPhone", b."guestTimeZone", b."meetingId", b."meetingUrl", b."netToProviderCents", b."paidAt", b."paymentDueAt", b."paymentProvider", b."paymentReference", b."paymentStatus", b."payoutAccountId", b."platformFeeCents", b."priceCents", b."providerPaymentId", b."recurringEventId", b."recurringIndex", b."refundedAt", b."reminderSent", b."rescheduleCount", b."startTime", b.status, b.uid, b."updatedAt", b."userId"&#xD;
          FROM bookings AS b&#xD;
          WHERE b.status = 'CONFIRMED'::"BookingStatus" AND NOT (b."reminderSent") AND b."startTime" &gt;= @now AND b."startTime" &lt;= @until&#xD;
          ORDER BY b."startTime", b.id&#xD;
          LIMIT @p&#xD;
      ) AS b0&#xD;
      INNER JOIN event_types AS e ON b0."eventTypeId" = e.id&#xD;
      INNER JOIN users AS u ON b0."userId" = u.id&#xD;
      ORDER BY b0."startTime", b0.id&#xD;
