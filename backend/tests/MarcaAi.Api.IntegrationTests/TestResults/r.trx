      LEFT JOIN (&#xD;
          SELECT e.id, e.title, e.slug, e.description, e.duration, e.color, e."locationType", e.price, e.currency, e."requiresConfirm", e."beforeEventBuffer", e."afterEventBuffer", e."bookingLimitDays", e0.id AS id0, e0.label, e0.type, e0.placeholder, e0.required, e0."order", e."payOnSite", e."createdAt", e."userId"&#xD;
          FROM event_types AS e&#xD;
          LEFT JOIN event_type_questions AS e0 ON e.id = e0."eventTypeId"&#xD;
