# MarcaAí — API .NET · variáveis de ambiente (formato Secao__Chave).
# Em dev prefira `dotnet user-secrets`; em produção (compose) use um .env FORA do git.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5433;Database=marcaai;Username=marcaai;Password=marcaai
Cors__FrontendOrigin=http://localhost:3000
App__PublicUrl=http://localhost:3000

Jwt__Issuer=https://api.marcaai.local
Jwt__Audience=marcaai-frontend
Jwt__SigningKey=            # >= 32 bytes aleatórios (ex.: openssl rand -base64 64)
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Jwt__CookieName=marcaai_at
Jwt__RefreshCookieName=marcaai_rt

Google__ClientId=
Google__ClientSecret=

Resend__ApiKey=
Resend__FromEmail=MarcaAí <onboarding@resend.dev>

WhatsApp__ApiUrl=
WhatsApp__ApiKey=
WhatsApp__InstanceName=MarcaAi

Stripe__SecretKey=
Stripe__WebhookSecret=
Stripe__ConnectWebhookSecret=
Stripe__PriceId=
Stripe__Prices__SoloPro=
Stripe__Prices__Clinica=
Stripe__Prices__ClinicaPro=
Platform__FeeFixedCents=0

MercadoPago__AccessToken=
MercadoPago__NotificationUrl=
